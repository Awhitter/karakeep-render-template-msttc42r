# Headless Chrome sidecar for Karakeep on Render.
# Stable Karakeep-tested image; the digest fixes both supported architectures.
FROM ghcr.io/karakeep-app/karakeep-chrome:151.0.7922.47-r1@sha256:5b19bbb160e9ff60681a3abd97e1c4ec9f64212301410de658c3900ab7ef31e7

# The inherited non-root user has no writable home; fontconfig uses this cache.
ENV XDG_CACHE_HOME=/tmp

# Inherit UID 65534 and /headless-shell/run.sh. The entrypoint supplies the
# sandbox flag and forwards private CDP port 9222 to its internal browser port.
# Overriding ENTRYPOINT or remote-debugging-port breaks that forwarding.
CMD ["--disable-gpu", "--disable-dev-shm-usage", "--hide-scrollbars", "--disable-blink-features=AutomationControlled", "--window-size=1440,900"]
